# Aesthetic Aroma — Backend Environment
# Copy to backend/.env and adjust. All values below are safe local defaults.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (sqlite | mysql)
DB_ENGINE=sqlite
DB_NAME=aesthetic_aroma
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF trusted origins (must include the exact frontend origin)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business
BUSINESS_TIMEZONE=Asia/Kolkata

# Rate limiting
LOGIN_THROTTLE_RATE=10/min
LOOKUP_THROTTLE_RATE=30/min
